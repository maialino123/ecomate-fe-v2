{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/admin/Dockerfile",
        "buildCommand": "echo 'Building Admin Dashboard with Docker...'",
        "watchPatterns": ["apps/admin/**", "packages/**"]
    },
    "deploy": {
        "numReplicas": 1,
        "startCommand": "node apps/admin/server.js",
        "healthcheckPath": "/",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    },
    "envVars": {
        "NODE_ENV": {
            "description": "Node environment",
            "default": "production"
        },
        "NEXT_PUBLIC_API_URL": {
            "description": "Backend API URL - Format: https://your-backend.railway.app/v1",
            "required": true
        },
        "NEXT_PUBLIC_APP_URL": {
            "description": "Admin dashboard public URL - Format: https://admin.yourdomain.com",
            "required": false
        },
        "NEXT_TELEMETRY_DISABLED": {
            "description": "Disable Next.js telemetry",
            "default": "1"
        }
    }
}
